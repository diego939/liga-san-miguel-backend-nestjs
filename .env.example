# Puerto HTTP del API (por defecto 3000 si no está definido)
PORT=3000

# Zona IANA para “día civil” en vigencias (inscripción, pase, planilla). Debe coincidir con `appTimeZone` del front.
# APP_TIMEZONE=America/Argentina/Buenos_Aires

# Orígenes permitidos para CORS (Angular `ng serve`, separados por coma). Vacío = localhost:4200.
# CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# PostgreSQL connection string (ajustá usuario, contraseña, host y nombre de BD)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/liga_san_miguel?schema=public"

JWT_SECRET="cambiar-por-secreto-largo-en-produccion"
JWT_EXPIRES_IN="7d"
